  .contact-footer-bar a:hover { color: #e63946; }
  .slide__content--contact {
    max-width: 1000px; display: grid; grid-template-columns: 1fr 1.4fr;
    gap: 3rem; align-items: start; text-align: left;
  }
  .contact__phone {
    display: inline-block; margin-top: 1rem; font-size: 1.5rem; font-weight: 700;
    color: #e63946; text-decoration: none; letter-spacing: 0.02em;
  }
  .contact__phone:hover { color: #ff6b6b; }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; opacity: 0.8; }
