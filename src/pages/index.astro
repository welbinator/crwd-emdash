  }
  .mobile-arrow:hover { background: rgba(230,57,70,0.7); }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .slide--portfolio, .slide--team, .slide--contact { align-items: flex-start; }
    .mobile-arrows { display: flex; }
    .nav {
      position: fixed; top: 70px; left: 0; right: 0; background: #fff;
      padding: 1.5rem 2rem; transform: translateY(calc(-100% - 70px));
      transition: transform 0.3s ease; box-shadow: 0 8px 24px rgba(0,0,0,0.1); z-index: 99;
    }
    .nav.nav--open { transform: translateY(0); }
    .nav__list { flex-direction: column; gap: 1.25rem; }
    /* Mobile dropdown — show inline, no absolute positioning */
    .nav__dropdown {
      display: none; position: static; box-shadow: none;
      padding: 0.25rem 0 0.25rem 1rem; border-left: 2px solid #e63946;
    }
    .has-dropdown.open .nav__dropdown { display: block; }
    .burger { display: flex; }
    .services-grid { grid-template-columns: 1fr; gap: 1rem; }
    .portfolio-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .portfolio-grid { grid-template-columns: 1fr; }
    .team-grid { grid-template-columns: 1fr; }
    .slide__content--contact { grid-template-columns: 1fr; gap: 2rem; }
    .slide--contact { padding-bottom: 2rem; flex-direction: column; justify-content: flex-start; }
    .contact-footer-bar { position: relative; bottom: auto; left: auto; right: auto; width: 100%; margin-top: auto; padding: 1rem; }
    .form-row { grid-template-columns: 1fr; }
    .slide-dots { display: none; }
    .slide { height: auto; min-height: 100vh; overflow-y: auto; overflow-x: hidden; position: absolute; -webkit-overflow-scrolling: touch; }
  }
