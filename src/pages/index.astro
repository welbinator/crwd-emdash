  .team-card__title { font-size: 0.85rem; color: #666; margin-bottom: 0.6rem; text-align: left; }
  .team-card__socials { display: flex; gap: 0.75rem; }
  .team-social { color: #444; font-size: 1rem; text-decoration: none; transition: color 0.2s; }
  .team-social:hover { color: #e63946; }
  .team-card__bio { font-size: 0.88rem; line-height: 1.7; color: #444; text-align: left; }
  .team-card__bio p + p { margin-top: 0.75rem; }
