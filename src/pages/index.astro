  .form-group input::placeholder, .form-group textarea::placeholder { opacity: 0.4; }
  .form-group input:focus, .form-group textarea:focus { outline: none; border-color: #e63946; }

  /* ── SLIDE DOTS ── */
  .slide-dots {
    position: fixed; right: 1.5rem; top: 50%; transform: translateY(-50%);
