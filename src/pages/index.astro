<script is:inline>
  const SLIDE_IDS = window.__SLIDE_IDS__ ?? ['hero','consultation','mobile-friendly','seo','services','portfolio','team','contact-us'];
  const slides = Array.from(document.querySelectorAll('.slide'));
  const dots = Array.from(document.querySelectorAll('.dot'));
  let current = 0;
  let isAnimating = false;
  const SLIDE_COUNT = slides.length;

  slides[0]?.classList.add('slide--active');
  slides.forEach((slide, i) => { if (i !== 0) { slide.setAttribute('inert', ''); slide.classList.add('slide--inactive'); } });

  function goTo(index) {
    if (isAnimating || index === current) return;
    isAnimating = true;
    const prevSlide = slides[current];
    const goingBack = index < current;
    prevSlide?.classList.remove('slide--active');
    prevSlide?.classList.add('slide--inactive');
    prevSlide?.setAttribute('inert', '');
    current = Math.max(0, Math.min(index, SLIDE_COUNT - 1));
    const nextSlide = slides[current];
    nextSlide?.classList.add('slide--active');
    nextSlide?.classList.remove('slide--inactive');
    nextSlide?.removeAttribute('inert');
    if (goingBack) { nextSlide.scrollTop = nextSlide.scrollHeight; }
    else { nextSlide.scrollTop = 0; }
    dots.forEach((d, i) => {
      d.classList.toggle('dot--active', i === current);
      d.setAttribute('aria-pressed', String(i === current));
    });
    setTimeout(() => { isAnimating = false; }, 650);
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => goTo(Number(dot.dataset.slide)));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') goTo(current + 1);
    if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   goTo(current - 1);
  });

  const BUFFER = 60;
  const SCROLL_END_DELAY = 150;
  const SNAP_DURATION = 900;
  let overscroll = 0;
  let isSnapping = false;
  let scrollEndTimer = null;

  function getActiveEl() { return slides[current]; }
  function atBottom(el) { return el.scrollTop + el.clientHeight >= el.scrollHeight - 2; }
  function atTop(el) { return el.scrollTop <= 0; }
  function resetOverscroll() { overscroll = 0; if (scrollEndTimer) clearTimeout(scrollEndTimer); scrollEndTimer = null; }
  function snapBack() {
    const el = getActiveEl();
    isSnapping = true;
    if (overscroll > 0) { el.scrollTop = el.scrollHeight - el.clientHeight; } else { el.scrollTop = 0; }
    setTimeout(() => { isSnapping = false; }, 400);
  }

  function handleWheel(e) {
    e.preventDefault();
    if (isSnapping || isAnimating) return;
    const direction = Math.sign(e.deltaY);
    const el = getActiveEl();
    const bottom = atBottom(el);
    const top = atTop(el);
    if ((direction > 0 && !bottom) || (direction < 0 && !top)) {
      el.scrollTop += e.deltaY; resetOverscroll(); return;
    }
    overscroll += e.deltaY;
    const absOver = Math.abs(overscroll);
    const overDir = Math.sign(overscroll);
    if (absOver >= BUFFER && overDir === direction) {
      const next = current + direction;
      if (next >= 0 && next < SLIDE_COUNT) {
        resetOverscroll(); isSnapping = true; goTo(next);
        setTimeout(() => { isSnapping = false; }, SNAP_DURATION);
      } else { snapBack(); resetOverscroll(); }
    } else {
      if (scrollEndTimer) clearTimeout(scrollEndTimer);
      scrollEndTimer = setTimeout(() => {
        if (Math.abs(overscroll) < BUFFER) snapBack();
        resetOverscroll();
      }, SCROLL_END_DELAY);
    }
  }

  window.addEventListener('wheel', handleWheel, { passive: false });

  let touchStartX = 0, touchStartY = 0;
  document.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX; touchStartY = e.touches[0].clientY;
  }, { passive: true });
  document.addEventListener('touchend', (e) => {
    if (isSnapping || isAnimating) return;
    const dx = e.changedTouches[0].clientX - touchStartX;
    const dy = e.changedTouches[0].clientY - touchStartY;
    const el = getActiveEl();
    if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 80) {
      if (dy < 0 && atBottom(el)) goTo(current + 1);
      if (dy > 0 && atTop(el)) goTo(current - 1);
    }
  }, { passive: true });

  // Nav anchor links
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const hash = (a.getAttribute('href') ?? '').replace('#', '');
      const idx = SLIDE_IDS.indexOf(hash);
      if (idx !== -1) {
        e.preventDefault();
        goTo(idx);
        document.getElementById('nav')?.classList.remove('nav--open');
        document.getElementById('burger')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.getElementById('prevBtn')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('nextBtn')?.addEventListener('click', () => goTo(current + 1));

  // Contact form
  document.getElementById('contactForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('contactSubmit');
    const success = document.getElementById('contactSuccess');
    const error = document.getElementById('contactError');
    btn.disabled = true; btn.textContent = 'Sending…';
    success.style.display = 'none'; error.style.display = 'none';
    try {
      const fd = new FormData(form);
      const data = {};
      for (const [k, v] of fd.entries()) data[k] = v;
      const res = await fetch('/_emdash/api/plugins/emdash-forms/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ formId: 'contact', data })
      });
      const json = await res.json();
      const ok = json.success && (json.data ? json.data.success !== false : true);
      if (ok) { success.style.display = 'block'; form.reset(); }
      else { error.style.display = 'block'; }
    } catch { error.style.display = 'block'; }
    finally { btn.disabled = false; btn.textContent = 'Send Message'; }
  });

  // Burger
  const burger = document.getElementById('burger');
  const nav = document.getElementById('nav');
  burger?.addEventListener('click', () => {
    const isOpen = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!isOpen));
    nav.classList.toggle('nav--open', !isOpen);
  });

  // Mobile: tap on a has-dropdown item toggles the submenu
  document.querySelectorAll('.has-dropdown > .nav__link').forEach(function(link) {
    link.addEventListener('click', function(e) {
      // Only intercept on mobile (burger visible)
      if (window.getComputedStyle(burger).display === 'none') return;
      e.preventDefault();
      var li = link.parentElement;
      li.classList.toggle('open');
    });
  });
</script>
